@model Hr.Application.ViewModels.EmployeesVM.FormVm

@{
    ViewData["Title"] = Model.Id == 0 ? "Add New Employee" : "Edit Employee";
}

<div class="post d-flex flex-column-fluid" id="kt_post">
    <div id="kt_content_container" class="container-xxl">
        <form id="employee-form" asp-action="@(Model.Id == 0 ? "Create" : "Edit")" method="post" class="form d-flex flex-column flex-lg-row">
            <input type="hidden" asp-for="Id" />

            <div class="d-flex flex-column flex-row-fluid gap-7 gap-lg-10">

                <!-- Page Header Title -->
                <div class="card card-flush py-4">
                    <div class="card-header">
                        <div class="card-title">
                            <h2>Employees Management - @(Model.Id == 0 ? "Add New Employee" : "Edit Employee")</h2>
                        </div>
                    </div>
                </div>

                <div class="row g-5">
                    <!-- Personal Information Section -->
                    <div class="col-xl-6">
                        <div class="card card-flush h-lg-100">
                            <div class="card-header">
                                <div class="card-title">
                                    <h3 class="fw-bold text-primary">Personal Information</h3>
                                </div>
                            </div>
                            <div class="card-body pt-0">
                                <div class="mb-5 fv-row">
                                    <label class="required form-label">Full Name</label>
                                    <input asp-for="FullName" class="form-control mb-2" placeholder="Enter full name" />
                                    <span asp-validation-for="FullName" class="text-danger"></span>
                                </div>

                                <!-- Address Sub-Fields -->
                                <div class="row mb-5">
                                    <div class="col-md-4 fv-row">
                                        <label class="required form-label">Country</label>
                                        <input asp-for="Address.Country" class="form-control mb-2" placeholder="Country" />
                                        <span asp-validation-for="Address.Country" class="text-danger"></span>
                                    </div>
                                    <div class="col-md-4 fv-row">
                                        <label class="required form-label">City</label>
                                        <input asp-for="Address.City" class="form-control mb-2" placeholder="City" />
                                        <span asp-validation-for="Address.City" class="text-danger"></span>
                                    </div>
                                    <div class="col-md-4 fv-row">
                                        <label class="required form-label">Street</label>
                                        <input asp-for="Address.Street" class="form-control mb-2" placeholder="Street" />
                                        <span asp-validation-for="Address.Street" class="text-danger"></span>
                                    </div>
                                </div>

                                <div class="mb-5 fv-row">
                                    <label class="required form-label">Phone Number</label>
                                    <input asp-for="PhoneNumber" class="form-control mb-2" placeholder="e.g. 01012345678" />
                                    <span asp-validation-for="PhoneNumber" class="text-danger"></span>
                                </div>

                                <div class="mb-5 fv-row">
                                    <label class="required form-label">Gender</label>
                                    <select asp-for="Gender" class="form-select mb-2" asp-items="Html.GetEnumSelectList<Hr.Domain.Enums.Gender>()">
                                        <option value="">Select Gender</option>
                                    </select>
                                    <span asp-validation-for="Gender" class="text-danger"></span>
                                </div>

                                <!-- Nationality Dropdown List -->
                                <div class="mb-5 fv-row">
                                    <label class="required form-label">Nationality</label>
                                    <select asp-for="NationalityId" asp-items="Model.Nationalites" class="form-select mb-2">
                                        <option value="">Select Nationality</option>
                                    </select>
                                    <span asp-validation-for="NationalityId" class="text-danger"></span>
                                </div>

                                <div class="mb-5 fv-row">
                                    <label class="required form-label">Date of Birth</label>
                                    <input asp-for="DateOfBirth" type="date" class="form-control mb-2" />
                                    <span asp-validation-for="DateOfBirth" class="text-danger"></span>
                                </div>

                                <div class="mb-5 fv-row">
                                    <label class="required form-label">National ID (14 digits)</label>
                                    <input asp-for="NationalId" class="form-control mb-2" placeholder="Enter 14-digit National ID" maxlength="14" />
                                    <span asp-validation-for="NationalId" class="text-danger"></span>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Work Information Section -->
                    <div class="col-xl-6">
                        <div class="card card-flush h-lg-100">
                            <div class="card-header">
                                <div class="card-title">
                                    <h3 class="fw-bold text-success">Work Information</h3>
                                </div>
                            </div>
                            <div class="card-body pt-0">
                                <div class="mb-5 fv-row">
                                    <label class="required form-label">Contract Date</label>
                                    <input asp-for="ContractDate" type="date" class="form-control mb-2" />
                                    <span asp-validation-for="ContractDate" class="text-danger"></span>
                                </div>

                                <!-- Department Dropdown List -->
                                <div class="mb-5 fv-row">
                                    <label class="required form-label">Department</label>
                                    <select asp-for="DepartmentId" asp-items="Model.Departments" class="form-select mb-2">
                                        <option value="">Select Department</option>
                                    </select>
                                    <span asp-validation-for="DepartmentId" class="text-danger"></span>
                                </div>

                                <div class="mb-5 fv-row">
                                    <label class="required form-label">Salary</label>
                                    <input asp-for="Salary" type="number" step="0.01" class="form-control mb-2" placeholder="Enter basic salary" />
                                    <span asp-validation-for="Salary" class="text-danger"></span>
                                </div>

                                <div class="mb-5 fv-row">
                                    <label class="required form-label">Default Check-In</label>
                                    <input asp-for="DefaultCheckIn" type="time" class="form-control mb-2" />
                                    <span asp-validation-for="DefaultCheckIn" class="text-danger"></span>
                                </div>

                                <div class="mb-5 fv-row">
                                    <label class="required form-label">Default Check-Out</label>
                                    <input asp-for="DefaultCheckOut" type="time" class="form-control mb-2" />
                                    <span asp-validation-for="DefaultCheckOut" class="text-danger"></span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Action Buttons -->
                <div class="d-flex justify-content-end mt-5 mb-5 gap-3">
                    <a asp-action="Index" class="btn btn-light me-3">Cancel</a>
                    <button type="button" id="save-button" class="btn btn-primary">
                        <span class="indicator-label">Save Employee</span>
                    </button>
                </div>

            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}

    <script>
        $(document).ready(function () {
            const $saveButton = $('#save-button');
            const $employeeForm = $('#employee-form');
            const modelId = @Model.Id;

            if ($saveButton.length && $employeeForm.length) {
                $saveButton.on('click', function (e) {
                    e.preventDefault();

                    if ($employeeForm.valid && !$employeeForm.valid()) {
                        return;
                    }

                    if (modelId > 0) {
                        Swal.fire({
                            title: 'Are you sure?',
                            text: "You are about to save changes for this employee.",
                            icon: 'question',
                            showCancelButton: true,
                            confirmButtonColor: '#009ef7',
                            cancelButtonColor: '#92929f',
                            confirmButtonText: 'Yes, save changes!',
                            cancelButtonText: 'Cancel'
                        }).then((result) => {
                            if (result.isConfirmed) {
                                $employeeForm.submit();
                            }
                        });
                    } else {
                        $employeeForm.submit();
                    }
                });
            }
        });
    </script>
}