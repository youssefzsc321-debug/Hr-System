@model IEnumerable<Hr.Application.ViewModels.EmployeesVM.GetEmployeesVM>

@{
    ViewData["Title"] = "Employees List";
}

<!--begin::Content wrapper-->
<div class="d-flex flex-column flex-column-fluid">
    <!--begin::Toolbar-->
    <div id="kt_app_toolbar" class="app-toolbar py-3 py-lg-6">
        <div id="kt_app_toolbar_container" class="app-container container-xxl d-flex flex-stack flex-wrap gap-2">
            <!--begin::Page title-->
            <div class="page-title d-flex flex-column justify-content-center flex-wrap me-3">
                <h1 class="page-heading d-flex text-dark fw-bold fs-3 flex-column justify-content-center my-0">Employees Management</h1>
                <ul class="breadcrumb breadcrumb-separatorless fw-semibold fs-7 my-0 pt-1">
                    <li class="breadcrumb-item text-muted">
                        <a href="/" class="text-muted text-hover-primary">Home</a>
                    </li>
                    <li class="breadcrumb-item">
                        <span class="bullet bg-gray-400 w-5px h-2px"></span>
                    </li>
                    <li class="breadcrumb-item text-muted">Employees</li>
                </ul>
            </div>
            <!--end::Page title-->
            <!--begin::Actions-->
            <div class="d-flex align-items-center gap-2 gap-lg-3">
                <a asp-controller="Employee" asp-action="Create" class="btn btn-sm fw-bold btn-primary">
                    <i class="ki-duotone ki-plus fs-2"></i> Add New Employee
                </a>
            </div>
            <!--end::Actions-->
        </div>
    </div>
    <!--end::Toolbar-->
    <!--begin::Content-->
    <div id="kt_app_content" class="app-content flex-column-fluid">
        <div id="kt_app_content_container" class="app-container container-xxl">
            <!--begin::Card-->
            <div class="card">
                <!--begin::Card header-->
                <div class="card-header border-0 pt-6">
                    <!--begin::Card title-->
                    <div class="card-title">
                        <!--begin::Search-->
                        <div class="d-flex align-items-center position-relative my-1">
                            <i class="ki-duotone ki-magnifier fs-3 position-absolute ms-5">
                                <span class="path1"></span>
                                <span class="path2"></span>
                            </i>
                            <input type="text" id="kt_filter_search" class="form-control form-control-solid w-250px ps-13" placeholder="Search employee..." />
                        </div>
                        <!--end::Search-->
                    </div>
                    <!--end::Card title-->
                </div>
                <!--end::Card header-->
                <!--begin::Card body-->
                <div class="card-body py-4">
                    <!--begin::Table-->
                    <table class="table align-middle table-row-dashed fs-6 gy-5" id="kt_employees_table" style="width: 100% !important;">
                        <!--begin::Table head-->
                        <thead>
                            <tr class="text-start text-muted fw-bold fs-7 text-uppercase gs-0">
                                <th>Full Name</th>
                                <th>Department</th>
                                <th>Phone Number</th>
                                <th>Gender</th>
                                <th>Salary</th>
                                <th>Contract Date</th>
                                <th>Status</th>
                                <th class="text-end">Actions</th>
                            </tr>
                        </thead>
                        <!--end::Table head-->
                        <!--begin::Table body-->
                        <tbody class="text-gray-600 fw-semibold">
                            @if (Model != null && Model.Any())
                            {
                                foreach (var employee in Model)
                                {
                                    <tr>
                                        <!--begin::Name-->
                                        <td>
                                            <div class="d-flex align-items-center">
                                                <div class="d-flex flex-column">
                                                    <a href="#" class="text-gray-800 text-hover-primary fs-5 fw-bold mb-1">@employee.FullName</a>
                                                    <span class="text-muted fs-7">National ID: @employee.NationalId</span>
                                                </div>
                                            </div>
                                        </td>
                                        <!--end::Name-->
                                        <!--begin::Department-->
                                        <td>
                                            <span class="badge badge-light-primary fw-bold px-3 py-2">@employee.DepartmentName</span>
                                        </td>
                                        <!--end::Department-->
                                        <!--begin::Phone-->
                                        <td>@employee.PhoneNumber</td>
                                        <!--end::Phone-->
                                        <!--begin::Gender-->
                                        <td>
                                            <span class="text-dark fw-bold">@(employee.Gender == Hr.Domain.Enums.Gender.Male ? "Male" : "Female")</span>
                                        </td>
                                        <!--end::Gender-->
                                        <!--begin::Salary-->
                                        <td><span class="text-dark fw-bold">@employee.Salary.ToString("N2")</span> EGP</td>
                                        <!--end::Salary-->
                                        <!--begin::Contract Date-->
                                        <td>@employee.ContractDate.ToString("yyyy-MM-dd")</td>
                                        <!--end::Contract Date-->
                                        <!--begin::Status-->
                                        <td>
                                            @if (!employee.IsDeleted)
                                            {
                                                <span class="badge badge-light-success fs-7 fw-bold px-3 py-2">Active</span>
                                            }
                                            else
                                            {
                                                <span class="badge badge-light-danger fs-7 fw-bold px-3 py-2">Inactive</span>
                                            }
                                        </td>
                                        <!--end::Status-->
                                        <!--begin::Action-->
                                        <td class="text-end">
                                            <a href="#" class="btn btn-sm btn-light btn-active-light-primary px-3 py-2 d-inline-flex align-items-center gap-1" data-kt-menu-trigger="click" data-kt-menu-placement="bottom-end">
                                                <span>Actions</span>
                                                <span style="font-size: 10px; margin-top: 1px;">▼</span>
                                            </a>
                                            <!--begin::Menu-->
                                            <div class="menu menu-sub menu-sub-dropdown menu-column menu-rounded menu-gray-600 menu-state-bg-light-primary fw-semibold fs-7 w-125px py-4" data-kt-menu="true">
                                                <div class="menu-item px-3">
                                                    <a asp-action="Edit" asp-route-id="@employee.Id" class="menu-link px-3">Edit</a>
                                                </div>
                                                <div class="menu-item px-3">
                                                    <form asp-action="ToggleStatus" asp-route-id="@employee.Id" method="post" class="w-100 toggle-form">
                                                        <button type="submit" class="menu-link px-3 w-100 text-start border-0 bg-transparent text-@(!employee.IsDeleted ? "danger" : "success")">
                                                            @(!employee.IsDeleted ? "Deactivate" : "Activate")
                                                        </button>
                                                    </form>
                                                </div>
                                            </div>
                                            <!--end::Menu-->
                                        </td>
                                        <!--end::Action-->
                                    </tr>
                                }
                            }
                        </tbody>
                        <!--end::Table body-->
                    </table>
                    <!--end::Table-->
                </div>
                <!--end::Card body-->
            </div>
            <!--end::Card-->
        </div>
    </div>
    <!--end::Content-->
</div>
<!--end::Content wrapper-->

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            // DataTable Initialization
            const table = document.querySelector('#kt_employees_table');
            if (table && $.fn.DataTable) {
                const datatable = $(table).DataTable({
                    "info": false,
                    "order": [],
                    "pageLength": 10,
                    "autoWidth": false,
                    "columnDefs": [
                        { "orderable": false, "targets": 7 }
                    ]
                });

                const filterSearch = document.querySelector('#kt_filter_search');
                if (filterSearch) {
                    filterSearch.addEventListener('keyup', function (e) {
                        datatable.search(e.target.value).draw();
                    });
                }
            }

            // SweetAlert Confirmation for Toggle Status
            const toggleForms = document.querySelectorAll('.toggle-form');
            toggleForms.forEach(form => {
                form.addEventListener('submit', function (e) {
                    e.preventDefault();
                    Swal.fire({
                        title: 'Are you sure?',
                        text: "Do you really want to change this employee's status?",
                        icon: 'warning',
                        showCancelButton: true,
                        confirmButtonColor: '#3085d6',
                        cancelButtonColor: '#d33',
                        confirmButtonText: 'Yes, sure!',
                        cancelButtonText: 'Cancel'
                    }).then((result) => {
                        if (result.isConfirmed) {
                            form.submit();
                        }
                    });
                });
            });
        });
    </script>
}