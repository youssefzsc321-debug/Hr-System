@model Hr.Application.ViewModels.AttendanceVM.AttendanceFilterVm

@{
    ViewData["Title"] = "Attendance Management";
}

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show d-flex align-items-center p-5 mb-5" role="alert">
        <div class="d-flex flex-column">
            <span class="fw-bold">@TempData["SuccessMessage"]</span>
        </div>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show d-flex align-items-center p-5 mb-5" role="alert">
        <div class="d-flex flex-column">
            <span class="fw-bold">@TempData["ErrorMessage"]</span>
        </div>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<!--begin::Card-->
<div class="card">
    <!--begin::Card header-->
    <div class="card-header border-0 pt-6">
        <!--begin::Card title-->
        <div class="card-title">
            <!--begin::Filter Form-->
            <form method="get" asp-action="Index" id="filterForm" class="d-flex align-items-start flex-wrap gap-3">
                <!-- Search Box -->
                <div>
                    <label class="form-label fs-7 fw-bold text-muted mb-1">Search</label>
                    <input type="text" name="searchTerm" value="@Model.SearchTerm" class="form-control form-control-solid w-200px" placeholder="Search by name or dept..." />
                </div>

                <!-- From Date -->
                <div>
                    <label class="form-label fs-7 fw-bold text-muted mb-1">From Date</label>
                    <input type="date" name="fromDate" value="@Model.FromDate?.ToString("yyyy-MM-dd")" class="form-control form-control-solid" />
                    <span class="text-danger fs-7 d-block mt-1" asp-validation-for="FromDate"></span>
                </div>

                <!-- To Date -->
                <div>
                    <label class="form-label fs-7 fw-bold text-muted mb-1">To Date</label>
                    <input type="date" name="toDate" value="@Model.ToDate?.ToString("yyyy-MM-dd")" class="form-control form-control-solid" />
                </div>

                <!-- Filter & Reset Buttons -->
                <div class="d-flex gap-2 mt-7">
                    <button type="submit" class="btn btn-primary">Filter</button>
                    <a asp-action="Index" class="btn btn-light btn-active-light-primary">Reset</a>
                </div>
            </form>
            <!--end::Filter Form-->
        </div>
        <!--end::Card title-->
        <!--begin::Card toolbar-->
        <div class="card-toolbar">
            <div class="d-flex justify-content-end gap-2">
                <button type="button" class="btn btn-light-success" data-bs-toggle="modal" data-bs-target="#kt_modal_import_excel">
                    Import Excel
                </button>
                <a asp-action="Create" asp-controller="Attendance" class="btn btn-primary">
                    Add Attendance
                </a>
            </div>
        </div>
        <!--end::Card toolbar-->
    </div>
    <!--end::Card header-->
    <!--begin::Card body-->
    <div class="card-body py-4">
        <!--begin::Table-->
        <table class="table align-middle table-row-dashed fs-6 gy-5" id="kt_table_attendances">
            <thead>
                <tr class="text-start text-muted fw-bold fs-7 text-uppercase gs-0">
                    <th class="min-w-125px">Employee Name</th>
                    <th class="min-w-125px">Department</th>
                    <th class="min-w-100px">Date</th>
                    <th class="min-w-100px">Check In</th>
                    <th class="min-w-100px">Check Out</th>
                    <th class="text-end min-w-100px">Actions</th>
                </tr>
            </thead>
            <tbody class="text-gray-600 fw-semibold">
                @if (Model.Attendances != null && Model.Attendances.Any())
                {
                    @foreach (var item in Model.Attendances)
                    {
                        <tr>
                            <td>@item.EmployeeName</td>
                            <td>@item.DepartmentName</td>
                            <td>@item.Date.ToString("yyyy-MM-dd")</td>
                            <td>
                                <span class="badge badge-light-success fs-7 fw-bold">@item.CheckIn</span>
                            </td>
                            <td>
                                @if (item.CheckOut.HasValue)
                                {
                                    <span class="badge badge-light-danger fs-7 fw-bold">@item.CheckOut</span>
                                }
                                else
                                {
                                    <span class="badge badge-light-warning fs-7 fw-bold">Not Checked Out</span>
                                }
                            </td>
                            <td class="text-end">
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-light-primary me-1">Edit</a>

                                <form asp-action="Delete" asp-route-id="@item.Id" method="post" class="d-inline js-delete-form">
                                    <button type="submit" class="btn btn-sm btn-light-danger">Delete</button>
                                </form>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="6" class="text-center text-muted py-4">No attendance records found.</td>
                    </tr>
                }
            </tbody>
        </table>
        <!--end::Table-->
    </div>
    <!--end::Card body-->
</div>
<!--end::Card-->
<!--begin::Modal - Import Excel-->
<div class="modal fade" id="kt_modal_import_excel" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered mw-500px">
        <div class="modal-content">
            <form asp-action="ImportExcel" method="post" enctype="multipart/form-data">
                <div class="modal-header">
                    <h2 class="fw-bold">Import Attendance from Excel</h2>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body py-5">
                    <div class="mb-3">
                        <label class="form-label required fw-semibold">Select Excel File (.xlsx)</label>
                        <input type="file" name="excelFile" accept=".xlsx" class="form-control form-control-solid" required />
                        <div class="form-text text-muted mt-2">
                            Columns order: <b>EmployeeId | Date | CheckIn | CheckOut</b>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-success">Upload & Import</button>
                </div>
            </form>
        </div>
    </div>
</div>
<!--end::Modal - Import Excel-->

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            if (typeof $ !== 'undefined' && $.fn.DataTable) {
                $("#kt_table_attendances").DataTable({
                    "searching": false, 
                    "language": {
                        "lengthMenu": "Show _MENU_",
                    },
                    "dom":
                        "<'row'" +
                        "<'col-sm-6 d-flex align-items-center justify-content-start'l>" +
                        "<'col-sm-6 d-flex align-items-center justify-content-end'>" +
                        ">" +
                        "<'row'" +
                        "<'col-sm-12'tr>" +
                        ">" +
                        "<'row'" +
                        "<'col-sm-12 col-md-5 d-flex align-items-center justify-content-center justify-content-md-start'i>" +
                        "<'col-sm-12 col-md-7 d-flex align-items-center justify-content-center justify-content-md-end'p>" +
                        ">"
                });
            }

            const filterForm = document.getElementById('filterForm');
            if (filterForm) {
                filterForm.addEventListener('submit', function (e) {
                    const searchTerm = document.querySelector('input[name="searchTerm"]').value.trim();
                    const fromDate = document.querySelector('input[name="fromDate"]').value;
                    const toDate = document.querySelector('input[name="toDate"]').value;

                    if (!searchTerm && !fromDate && !toDate) {
                        e.preventDefault();
                        if (typeof Swal !== 'undefined') {
                            Swal.fire({
                                title: 'Validation Error',
                                text: 'Please enter a search term or select a date range to filter.',
                                icon: 'warning',
                                confirmButtonText: 'OK',
                                customClass: {
                                    confirmButton: 'btn btn-primary'
                                },
                                buttonsStyling: false
                            });
                        } else {
                            alert('Please enter a search term or select a date range to filter.');
                        }
                    }
                });
            }

            document.querySelectorAll('.js-delete-form').forEach(function (form) {
                form.addEventListener('submit', function (e) {
                    e.preventDefault();
                    var currentForm = this;

                    if (typeof Swal !== 'undefined') {
                        Swal.fire({
                            title: 'Confirm Delete',
                            text: 'Are you sure you want to delete this attendance record?',
                            icon: 'warning',
                            showCancelButton: true,
                            confirmButtonText: 'Yes, delete it!',
                            cancelButtonText: 'Cancel',
                            customClass: {
                                confirmButton: 'btn btn-danger',
                                cancelButton: 'btn btn-light'
                            },
                            buttonsStyling: false
                        }).then(function (result) {
                            if (result.isConfirmed) {
                                currentForm.submit();
                            }
                        });
                    } else {
                        if (confirm('Are you sure you want to delete this attendance record?')) {
                            currentForm.submit();
                        }
                    }
                });
            });
        });
    </script>
}