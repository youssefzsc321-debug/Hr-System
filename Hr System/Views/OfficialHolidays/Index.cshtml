@model IEnumerable<Hr.Application.ViewModels.OfficialHoliday.OfficialHolidayFormVm>

@{
    ViewData["Title"] = "Official Holidays Management";
}

<!--begin::Content wrapper-->
<div class="d-flex flex-column flex-column-fluid">
    <!--begin::Toolbar-->
    <div id="kt_app_toolbar" class="app-toolbar py-3 py-lg-6">
        <div id="kt_app_toolbar_container" class="app-container container-xxl d-flex flex-stack flex-wrap gap-2">
            <div class="page-title d-flex flex-column justify-content-center flex-wrap me-3">
                <h1 class="page-heading d-flex text-dark fw-bold fs-3 flex-column justify-content-center my-0">Official Holidays</h1>
                <ul class="breadcrumb breadcrumb-separatorless fw-semibold fs-7 my-0 pt-1">
                    <li class="breadcrumb-item text-muted"><a href="/" class="text-muted text-hover-primary">Home</a></li>
                    <li class="breadcrumb-item"><span class="bullet bg-gray-400 w-5px h-2px"></span></li>
                    <li class="breadcrumb-item text-muted">Settings</li>
                    <li class="breadcrumb-item"><span class="bullet bg-gray-400 w-5px h-2px"></span></li>
                    <li class="breadcrumb-item text-dark">Official Holidays</li>
                </ul>
            </div>
            <div class="d-flex align-items-center gap-2 gap-lg-3">
                <span class="badge badge-light-success fw-bold fs-8 px-4 py-3">
                    <i class="ki-duotone ki-calendar-tick fs-5 text-success me-1">
                        <span class="path1"></span><span class="path2"></span><span class="path3"></span><span class="path4"></span><span class="path5"></span><span class="path6"></span>
                    </i>
                    HR Calendar Module
                </span>
            </div>
        </div>
    </div>
    <!--end::Toolbar-->
    <!--begin::Content-->
    <div id="kt_app_content" class="app-content flex-column-fluid">
        <div id="kt_app_content_container" class="container-xxl">

            <!--begin::Add Holiday Card (Form)-->
            <div class="card card-flush mb-7">
                <div class="card-header pt-7">
                    <div class="card-title">
                        <i class="ki-duotone ki-plus-square fs-2x text-primary me-2"><span class="path1"></span><span class="path2"></span><span class="path3"></span></i>
                        <h3 class="fw-bold text-gray-800">Add New Official Holiday</h3>
                    </div>
                </div>
                <div class="card-body">
                    <form id="add-holiday-form" class="form">
                        <div class="row g-5 align-items-end">
                            <div class="col-xl-4 fv-row">
                                <label class="required form-label fw-bold">Holiday Name</label>
                                <input type="text" id="HolidayName" class="form-control form-control-solid" placeholder="e.g. 6th of October" />
                            </div>
                            <div class="col-xl-3 fv-row">
                                <label class="required form-label fw-bold">Start Date</label>
                                <input type="date" id="StartDate" class="form-control form-control-solid" />
                            </div>
                            <div class="col-xl-3 fv-row">
                                <label class="required form-label fw-bold">End Date</label>
                                <input type="date" id="EndDate" class="form-control form-control-solid" />
                            </div>
                            <div class="col-xl-2">
                                <button type="button" id="save-holiday-btn" class="btn btn-primary w-100">
                                    <i class="ki-duotone ki-check fs-2 me-1"><span class="path1"></span><span class="path2"></span></i>
                                    Add
                                </button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
            <!--end::Add Holiday Card-->
            <!--begin::Holidays Table Card-->
            <div class="card card-flush">
                <div class="card-header pt-7">
                    <div class="card-title">
                        <i class="ki-duotone ki-calendar-search fs-2x text-success me-2"><span class="path1"></span><span class="path2"></span><span class="path3"></span></i>
                        <h3 class="fw-bold text-gray-800">Official Holidays List</h3>
                    </div>
                </div>
                <div class="card-body pt-0">
                    <div class="table-responsive">
                        <table id="kt_holidays_table" class="table align-middle table-row-dashed fs-6 gy-5">
                            <thead>
                                <tr class="text-start text-muted fw-bold fs-7 text-uppercase gs-0">
                                    <th class="min-w-200px">Holiday Name</th>
                                    <th class="min-w-150px">Start Date</th>
                                    <th class="min-w-150px">End Date</th>
                                    <th class="text-end min-w-120px">Actions</th>
                                </tr>
                            </thead>
                            <tbody class="text-gray-600 fw-semibold" id="holidays-table-body">
                                @if (Model != null && Model.Any())
                                {
                                    @foreach (var item in Model)
                                    {
                                        <tr data-id="@item.Id">
                                            <td>@item.Name</td>
                                            <td>@item.StartDate.ToString("yyyy-MM-dd")</td>
                                            <td>@item.EndDate.ToString("yyyy-MM-dd")</td>
                                            <td class="text-end">
                                                <div class="d-flex justify-content-end flex-shrink-0">
                                                    <!-- Edit Button -->
                                                    <button type="button" class="btn btn-sm btn-light-primary px-3 py-2 me-2 fw-bold edit-holiday-btn" data-id="@item.Id">
                                                        Edit
                                                    </button>
                                                    <!-- Delete Button -->
                                                    <button type="button" class="btn btn-sm btn-light-danger px-3 py-2 fw-bold delete-holiday-btn" data-id="@item.Id">
                                                        Delete
                                                    </button>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
            <!--end::Holidays Table Card-->

        </div>
    </div>
    <!--end::Content-->
</div>
<!--end::Content wrapper-->
<partial name="_Modal" />

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>

        $(document).ready(function () {
            const table = $('#kt_holidays_table').DataTable({
                "order": [[1, "asc"]]
            });

            let currentEditRow = null; 

            $('#save-holiday-btn').on('click', function (e) {
                e.preventDefault();

                const name = $('#HolidayName').val().trim();
                const startDate = $('#StartDate').val();
                const endDate = $('#EndDate').val();

                if (!name || !startDate || !endDate) {
                    Swal.fire({
                        title: 'Missing Fields',
                        text: 'Please fill in all required fields.',
                        icon: 'warning',
                        confirmButtonColor: '#009ef7'
                    });
                    return;
                }

                const formData = { Name: name, StartDate: startDate, EndDate: endDate };

                $.ajax({
                    url: '/OfficialHolidays/AddHolidayAjax',
                    type: 'POST',
                    data: formData,
                    success: function (response) {
                        if (response.success) {
                            table.row.add([
                                response.data.name,
                                response.data.startDate.split('T')[0],
                                response.data.endDate.split('T')[0],
                                `<td class="text-end">
                                            <div class="d-flex justify-content-end flex-shrink-0">
                                                <button type="button" class="btn btn-sm btn-light-primary px-3 py-2 me-2 fw-bold edit-holiday-btn" data-id="${response.data.id}">Edit</button>
                                                <button type="button" class="btn btn-sm btn-light-danger px-3 py-2 fw-bold delete-holiday-btn" data-id="${response.data.id}">Delete</button>
                                            </div>
                                        </td>`
                            ]).draw(false);

                            $('#add-holiday-form')[0].reset();
                            Swal.fire({ title: 'Added Successfully!', icon: 'success', timer: 1500, showConfirmButton: false });
                        } else {
                            Swal.fire('Error!', response.message, 'error');
                        }
                    }
                });
            });

            $(document).on('click', '.edit-holiday-btn', function () {
                const id = $(this).data('id');
                currentEditRow = $(this).closest('tr');

                $.ajax({
                    url: '/OfficialHolidays/Edit',
                    type: 'GET',
                    data: { id: id },
                    success: function (htmlResponse) {
                        $('#CommonModalBody').html(htmlResponse);
                        $('#CommonModalLabel').text('Edit Official Holiday');

                        const myModal = new bootstrap.Modal(document.getElementById('CommonModal'));
                        myModal.show();
                    }
                });
            });

            $('#modal-save-btn').on('click', function () {
                Swal.fire({
                    title: 'Are you sure?',
                    text: "Do you want to save these changes?",
                    icon: 'question',
                    showCancelButton: true,
                    confirmButtonColor: '#009ef7',
                    cancelButtonColor: '#92929f',
                    confirmButtonText: 'Yes, save it!'
                }).then((result) => {
                    if (result.isConfirmed) {
                        const formDataArray = $('#EditHolidayForm').serializeArray();
                        const formDataObj = {};
                        formDataArray.forEach(item => formDataObj[item.name] = item.value);

                        $.ajax({
                            url: '/OfficialHolidays/Edit',
                            type: 'POST',
                            data: formDataArray,
                            success: function (response) {
                                if (response.success) {
                                    const modalEl = document.getElementById('CommonModal');
                                    const modalInstance = bootstrap.Modal.getInstance(modalEl);
                                    modalInstance.hide();

                                    table.row(currentEditRow).data([
                                        formDataObj.Name,
                                        formDataObj.StartDate,
                                        formDataObj.EndDate,
                                        `<td class="text-end">
                                                    <div class="d-flex justify-content-end flex-shrink-0">
                                                        <button type="button" class="btn btn-sm btn-light-primary px-3 py-2 me-2 fw-bold edit-holiday-btn" data-id="${formDataObj.Id}">Edit</button>
                                                        <button type="button" class="btn btn-sm btn-light-danger px-3 py-2 fw-bold delete-holiday-btn" data-id="${formDataObj.Id}">Delete</button>
                                                    </div>
                                                </td>`
                                    ]).draw(false);

                                    Swal.fire({
                                        title: 'Updated Successfully!',
                                        icon: 'success',
                                        timer: 1500,
                                        showConfirmButton: false
                                    });
                                } else {
                                    Swal.fire('Error!', response.message, 'error');
                                }
                            }
                        });
                    }
                });
            });

            $(document).on('click', '.delete-holiday-btn', function () {
                const btn = $(this);
                const id = btn.data('id');
                const row = btn.closest('tr');

                Swal.fire({
                    title: 'Are you sure?',
                    text: "You won't be able to revert this!",
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonColor: '#f1416c',
                    cancelButtonColor: '#92929f',
                    confirmButtonText: 'Yes, delete it!'
                }).then((result) => {
                    if (result.isConfirmed) {
                        $.ajax({
                            url: '/OfficialHolidays/Delete',
                            type: 'POST',
                            data: { id: id },
                            success: function (response) {
                                if (response.success) {
                                    table.row(row).remove().draw(false);
                                    Swal.fire({ title: 'Deleted!', icon: 'success', timer: 1500, showConfirmButton: false });
                                } else {
                                    Swal.fire('Error!', response.message, 'error');
                                }
                            }
                        });
                    }
                });
            });
        });
    </script>
}