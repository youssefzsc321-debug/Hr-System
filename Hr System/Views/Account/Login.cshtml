@model Hr.Application.ViewModels.User.LoginVm
@{
    ViewData["Title"] = "Login";
}

<!--begin::Authentication - Sign-in -->
<div class="d-flex flex-column flex-root" id="kt_app_root">
    <div class="d-flex flex-column flex-lg-row flex-column-fluid">

        <div class="d-flex flex-column flex-lg-row-auto w-lg-600px positon-xl-relative overflow-hidden" style="background-color: #151521;">
            <div class="d-flex flex-column flex-center-fluid flex-center p-10 py-lg-20 w-100 mx-auto mw-450px">

                <!--begin::Card Form Box-->
                <div class="bg-body rounded shadow-sm p-10 p-lg-15 w-100" style="background-color: #1e1e2d !important; border: 1px solid #2b2b40;">

                    <!--begin::Form-->
                    <form class="form w-100" novalidate="novalidate" id="kt_sign_in_form" asp-action="Login" method="post">

                        <!--begin::Logo / Icon Placeholder-->
                        <div class="text-center mb-7">
                            <img alt="Logo" src="~/assets/images/logo2.png" class="h-80px" />
                        </div>
                        <!--end::Logo-->
                        <!--begin::Heading-->
                        <div class="text-center mb-10">
                            <h1 class="text-white fw-bolder mb-3 fs-2qx">Sign In</h1>
                        </div>
                        <!--end::Heading-->
                        <!--begin::Validation Summary-->
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger fs-6 p-4 mb-10 text-center" role="alert"></div>
                        <!--end::Validation Summary-->
                        <!--begin::Input group=-->
                        <div class="fv-row mb-8">
                            <input class="form-control form-control-solid border-0" type="text" asp-for="EmailOrUserName" placeholder="Username or Email" autocomplete="off" style="background-color: #ffffff !important; color: #000000 !important;" />
                            <span asp-validation-for="EmailOrUserName" class="text-danger fs-7 mt-1"></span>
                        </div>
                        <!--end::Input group-->
                        <!--begin::Input group-->
                        <div class="fv-row mb-3">
                            <input class="form-control form-control-solid border-0" type="password" asp-for="Password" placeholder="Password" autocomplete="off" style="background-color: #ffffff !important; color: #000000 !important;" />
                            <span asp-validation-for="Password" class="text-danger fs-7 mt-1"></span>
                        </div>
                        <!--end::Input group-->
                        <!--begin::Wrapper-->
                        <div class="d-flex flex-stack flex-wrap gap-3 fs-base fw-semibold mb-8">
                            <div>
                                <div class="form-check form-check-custom form-check-solid">
                                    <input class="form-check-input" type="checkbox" asp-for="RememberMe" id="remember_me" />
                                    <label class="form-check-label text-gray-400 fs-7" for="remember_me">Remember me</label>
                                </div>
                            </div>
                            <a href="#" class="link-primary fs-7">Forgot Password?</a>
                        </div>
                        <!--end::Wrapper-->
                        <!--begin::Submit button-->
                        <div class="d-grid mb-10">
                            <button type="submit" id="kt_sign_in_submit" class="btn btn-primary fw-bold py-3">
                                <span class="indicator-label">Sign In</span>
                                <span class="indicator-progress">
                                    Please wait...
                                    <span class="spinner-border spinner-border-sm align-middle ms-2"></span>
                                </span>
                            </button>
                        </div>
                        <!--end::Submit button-->

                    </form>
                    <!--end::Form-->
                </div>
                <!--end::Card Form Box-->

            </div>
        </div>
        <!--end::Body-->
        <div class="d-flex flex-column flex-lg-row-fluid align-items-center justify-content-center p-10 overflow-hidden position-relative"
             style="background-image: url('@Url.Content("~/assets/images/v1016-b-09.jpg")'); background-size: cover; background-position: center; background-repeat: no-repeat;">

            <div class="position-absolute top-0 start-0 w-100 h-100" style="background: linear-gradient(135deg, rgba(13, 13, 20, 0.9) 0%, rgba(21, 21, 33, 0.8) 100%);"></div>

            <div class="d-flex flex-column align-items-center text-center p-10 position-relative z-index-1">

                <img class="mw-100 w-400px mb-8" src="~/assets/images/Computer login-bro.svg" alt="Vector Character" />

                <h1 class="text-white fs-2qx fw-bolder text-center mb-3">HR System, by Youssef</h1>

                <p class="text-gray-300 fs-base mw-500px">
                    Manage your employees, attendance, departures, and payroll seamlessly with a high-performance architecture and clean design.
                </p>

            </div>
        </div>
        <!--end::Aside-->

    </div>
</div>
<!--end::Authentication - Sign-in-->

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}