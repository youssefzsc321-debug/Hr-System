```cshtml
@model Hr.Application.ViewModels.EmployeeReports.SalaryReportFilterVm

@{
    ViewData["Title"] = "Salary Report";
}

<!--begin::Card-->
<div class="card shadow-sm">

    <!--begin::Card header-->
    <div class="card-header border-0 pt-6 pb-4">
        <div class="card-title w-100">

            <form method="get"
                  asp-action="Index"
                  asp-controller="SalaryReport"
                  class="row g-3 align-items-end w-100">

                <!-- Employee Name Search -->
                <div class="col-md-4">
                    <label class="form-label fs-7 fw-bold text-muted mb-2">
                        Employee Name
                    </label>

                    <div class="position-relative">
                        <input type="text"
                               name="employeeName"
                               value="@Model.SearchTerm"
                               class="form-control form-control-solid"
                               placeholder="Search by employee name..." />
                    </div>
                </div>

                <!-- Month Dropdown -->
                <div class="col-md-3">
                    <label class="form-label fs-7 fw-bold text-muted mb-2">
                        Month
                    </label>

                    <select name="month" class="form-select form-select-solid">
                        @for (int i = 1; i <= 12; i++)
                        {
                            var monthName = System.Globalization.CultureInfo.CurrentCulture.DateTimeFormat.GetMonthName(i);

                            <option value="@i"
                                    selected="@(Model.Month == i ? "selected" : null)">
                                @monthName (@i)
                            </option>
                        }
                    </select>
                </div>

                <!-- Year Input -->
                <div class="col-md-2">
                    <label class="form-label fs-7 fw-bold text-muted mb-2">
                        Year
                    </label>

                    <input type="number"
                           name="year"
                           value="@Model.Year"
                           class="form-control form-control-solid"
                           min="2008"
                           max="2100" />
                </div>

                <!-- Action Buttons -->
                <div class="col-md-3 d-flex gap-2">
                    <button type="submit"
                            class="btn btn-primary flex-grow-1">
                        Filter
                    </button>

                    <a asp-action="Index"
                       class="btn btn-light btn-active-light-primary">
                        Reset
                    </a>
                </div>

            </form>

        </div>
    </div>
    <!--end::Card header-->
    <!--begin::Card body-->
    <div class="card-body py-4">

        <div class="table-responsive">

            <table class="table align-middle table-row-dashed fs-6 gy-5"
                   id="kt_table_salaries">

                <thead>
                    <tr class="text-start text-muted fw-bold fs-7 text-uppercase gs-0">
                        <th class="min-w-150px">Employee Name</th>
                        <th class="min-w-110px">Department</th>
                        <th class="min-w-100px">Basic Salary</th>
                        <th class="min-w-90px text-center">Attendance</th>
                        <th class="min-w-90px text-center">Absence</th>
                        <th class="min-w-100px text-center">Overtime (Hrs)</th>
                        <th class="min-w-100px text-center">Deduction (Hrs)</th>
                        <th class="min-w-110px text-center">Total Overtime</th>
                        <th class="min-w-110px text-center">Total Deduction</th>
                        <th class="min-w-120px text-center">Net Salary</th>
                        <th class="text-end min-w-90px no-print">Actions</th>
                    </tr>
                </thead>

                <tbody class="text-gray-600 fw-semibold">

                    @if (Model.ReportRecords != null && Model.ReportRecords.Any())
                    {
                        foreach (var item in Model.ReportRecords)
                        {
                            <tr>

                                <td class="text-gray-800 fw-bold">
                                    @item.EmployeeName
                                </td>

                                <td>
                                    <span class="badge badge-light-info fs-7 fw-semibold">
                                        @item.DepartmentName
                                    </span>
                                </td>

                                <td>
                                    <span class="badge badge-light-secondary text-gray-800 fs-7 fw-bold">
                                        @item.BasicSalary.ToString("N2") EGP
                                    </span>
                                </td>

                                <td class="text-center">
                                    <span class="badge badge-light-success fs-7 fw-bold">
                                        @item.DaysPresent Days
                                    </span>
                                </td>

                                <td class="text-center">
                                    <span class="badge badge-light-danger fs-7 fw-bold">
                                        @item.DaysAbsent Days
                                    </span>
                                </td>

                                <td class="text-center">
                                    <span class="badge badge-light-primary fs-7 fw-bold">
                                        @item.OvertimeHours Hrs
                                    </span>
                                </td>

                                <td class="text-center">
                                    <span class="badge badge-light-warning fs-7 fw-bold">
                                        @item.DeductionHours Hrs
                                    </span>
                                </td>

                                <td class="text-center">
                                    <span class="badge badge-light-success fs-7 fw-bold">
                                        + @item.TotalOvertime.ToString("N2") EGP
                                    </span>
                                </td>

                                <td class="text-center">
                                    <span class="badge badge-light-danger fs-7 fw-bold">
                                        - @item.TotalDeduction.ToString("N2") EGP
                                    </span>
                                </td>

                                <td class="text-center">
                                    <span class="badge badge-success fs-6 fw-bold">
                                        @item.NetSalary.ToString("N2") EGP
                                    </span>
                                </td>

                                <!-- Actions -->
                                <td class="text-end no-print">
                                    <div class="d-flex justify-content-end gap-2">

                                        <!-- Edit Employee -->
                                        <a asp-controller="Employee"
                                           asp-action="Edit"
                                           asp-route-id="@item.EmployeeId"
                                           class="btn btn-sm btn-icon btn-light-warning"
                                           title="Edit Employee">

                                            <i class="fa-solid fa-pen-to-square fs-5"></i>

                                        </a>

                                        <!-- Print Payslip -->
                                        <button type="button"
                                                class="btn btn-sm btn-icon btn-light-primary"
                                                onclick="printEmployeeRow(this)"
                                                title="Print Payslip">

                                            <i class="fa-solid fa-print fs-5"></i>

                                        </button>

                                    </div>
                                </td>

                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="11"
                                class="text-center text-muted py-8 fs-5">
                                No employee salary records found for the selected criteria.
                            </td>
                        </tr>
                    }

                </tbody>
            </table>

        </div>
    </div>
    <!--end::Card body-->

</div>
<!--end::Card-->


@section Scripts {

    <script>

        document.addEventListener("DOMContentLoaded", function () {

            if (typeof $ !== 'undefined' && $.fn.DataTable) {

                if (!$.fn.DataTable.isDataTable('#kt_table_salaries')) {

                    $("#kt_table_salaries").DataTable({

                        "searching": false,
                        "ordering": true,
                        "paging": true,
                        "pageLength": 10,
                        "lengthMenu": [5, 10, 25, 50],

                        "language": {
                            "lengthMenu": "Show _MENU_",
                            "info": "Showing _START_ to _END_ of _TOTAL_ entries",

                            "paginate": {
                                "previous": "<i class='previous'></i>",
                                "next": "<i class='next'></i>"
                            }
                        }

                    });
                }
            }
        });


        function printEmployeeRow(btn) {

            var row = $(btn).closest('tr');

            var empName = row.find('td:eq(0)').text().trim();
            var dept = row.find('td:eq(1)').text().trim();
            var basic = row.find('td:eq(2)').text().trim();
            var present = row.find('td:eq(3)').text().trim();
            var absent = row.find('td:eq(4)').text().trim();
            var overtimeHrs = row.find('td:eq(5)').text().trim();
            var deductionHrs = row.find('td:eq(6)').text().trim();
            var overtime = row.find('td:eq(7)').text().trim();
            var deduction = row.find('td:eq(8)').text().trim();
            var net = row.find('td:eq(9)').text().trim();

            var printWindow = window.open('', '_blank', 'width=800,height=650');

            printWindow.document.write(`

                <html>
                <head>

                    <title>Salary Payslip - ${empName}</title>

                    <style>

                        body {
                            font-family: Arial, sans-serif;
                            padding: 30px;
                            color: #333;
                        }

                        .payslip-box {
                            border: 2px solid #2b2b40;
                            border-radius: 8px;
                            padding: 25px;
                            max-width: 600px;
                            margin: auto;
                        }

                        .header {
                            text-align: center;
                            border-bottom: 2px dashed #ccc;
                            padding-bottom: 15px;
                            margin-bottom: 20px;
                        }

                        .row-item {
                            display: flex;
                            justify-content: space-between;
                            padding: 10px 0;
                            border-bottom: 1px solid #eee;
                            font-size: 16px;
                        }

                        .net-row {
                            display: flex;
                            justify-content: space-between;
                            padding: 15px 10px;
                            background: #e8fff3;
                            color: #1bc5bd;
                            font-weight: bold;
                            font-size: 18px;
                            margin-top: 15px;
                            border-radius: 6px;
                        }

                    </style>

                </head>

                <body>

                    <div class="payslip-box">

                        <div class="header">
                            <h2>Employee Salary Payslip</h2>
                            <p>Period: @Model.Month / @Model.Year</p>
                        </div>

                        <div class="row-item">
                            <strong>Employee Name:</strong>
                            <span>${empName}</span>
                        </div>

                        <div class="row-item">
                            <strong>Department:</strong>
                            <span>${dept}</span>
                        </div>

                        <div class="row-item">
                            <strong>Basic Salary:</strong>
                            <span>${basic}</span>
                        </div>

                        <div class="row-item">
                            <strong>Attendance Days:</strong>
                            <span>${present}</span>
                        </div>

                        <div class="row-item">
                            <strong>Absence Days:</strong>
                            <span>${absent}</span>
                        </div>

                        <div class="row-item">
                            <strong>Overtime Hours:</strong>
                            <span>${overtimeHrs}</span>
                        </div>

                        <div class="row-item">
                            <strong>Deduction Hours:</strong>
                            <span>${deductionHrs}</span>
                        </div>

                        <div class="row-item">
                            <strong>Total Overtime:</strong>
                            <span style="color:green">${overtime}</span>
                        </div>

                        <div class="row-item">
                            <strong>Total Deductions:</strong>
                            <span style="color:red">${deduction}</span>
                        </div>

                        <div class="net-row">
                            <strong>Net Salary:</strong>
                            <span>${net}</span>
                        </div>

                    </div>

                    <script>
                        window.onload = function() {
                            window.print();
                            window.close();
                        }
                    <\/script>

                </body>
                </html>

            `);

            printWindow.document.close();
        }

    </script>
}
```