@model Hr.Application.ViewModels.EmployeeReports.SalaryReportFilterVm

@{
    ViewData["Title"] = "Salary Report";
}

<!--begin::Card-->
<div class="card shadow-sm">

    <!--begin::Card header-->
    <div class="card-header border-0 pt-6 pb-4">
        <div class="card-title w-100">

            <form method="get"
                  asp-action="Index"
                  asp-controller="SalaryReport"
                  class="row g-3 align-items-end w-100">

                <!-- Employee Name Search -->
                <div class="col-md-3">
                    <label class="form-label fs-7 fw-bold text-muted mb-2">
                        Employee Name
                    </label>
                    <div class="position-relative">
                        <input type="text"
                               name="employeeName"
                               value="@Model.SearchTerm"
                               class="form-control form-control-solid"
                               placeholder="Search by employee name..." />
                    </div>
                </div>

                <!-- Month Dropdown -->
                <div class="col-md-3">
                    <label class="form-label fs-7 fw-bold text-muted mb-2">
                        Month
                    </label>
                    <select name="month" class="form-select form-select-solid">
                        @for (int i = 1; i <= 12; i++)
                        {
                            var monthName = System.Globalization.CultureInfo.CurrentCulture.DateTimeFormat.GetMonthName(i);
                            <option value="@i" selected="@(Model.Month == i ? "selected" : null)">
                                @monthName (@i)
                            </option>
                        }
                    </select>
                </div>

                <!-- Year Input -->
                <div class="col-md-2">
                    <label class="form-label fs-7 fw-bold text-muted mb-2">
                        Year
                    </label>
                    <input type="number"
                           name="year"
                           value="@Model.Year"
                           class="form-control form-control-solid"
                           min="2008"
                           max="2100" />
                </div>

                <!-- Action & Export Buttons -->
                <div class="col-md-4 d-flex gap-2">
                    <button type="submit" class="btn btn-primary flex-grow-1">
                        Filter
                    </button>

                    <a asp-action="Index" class="btn btn-light btn-active-light-primary">
                        Reset
                    </a>

                    <!-- Global Export Dropdown for the Entire Table -->
                    <div class="btn-group">
                        <button type="button" class="btn btn-light-primary dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false">
                            <i class="fa-solid fa-download me-1"></i> Export All
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end shadow-sm">
                            <li>
                                <a class="dropdown-item py-2"
                                   asp-controller="SalaryReport"
                                   asp-action="ExportSalaryToExcel"
                                   asp-route-employeeName="@Model.SearchTerm"
                                   asp-route-month="@Model.Month"
                                   asp-route-year="@Model.Year">
                                    <i class="fa-solid fa-file-excel text-success me-2"></i> Export Table to Excel
                                </a>
                            </li>
                            <li>
                                <a class="dropdown-item py-2"
                                   asp-controller="SalaryReport"
                                   asp-action="ExportSalaryToPDF"
                                   asp-route-employeeName="@Model.SearchTerm"
                                   asp-route-month="@Model.Month"
                                   asp-route-year="@Model.Year">
                                    <i class="fa-solid fa-file-pdf text-danger me-2"></i> Export Table to PDF
                                </a>
                            </li>
                        </ul>
                    </div>
                </div>

            </form>

        </div>
    </div>
    <!--end::Card header-->
    <!--begin::Card body-->
    <div class="card-body py-4">
        <div class="table-responsive" style="overflow-x: visible;">

            <table class="table align-middle table-row-dashed fs-6 gy-5" id="kt_table_salaries">
                <thead>
                    <tr class="text-start text-muted fw-bold fs-7 text-uppercase gs-0">
                        <th class="min-w-150px">Employee Name</th>
                        <th class="min-w-110px">Department</th>
                        <th class="min-w-100px">Basic Salary</th>
                        <th class="min-w-90px text-center">Attendance</th>
                        <th class="min-w-90px text-center">Absence</th>
                        <th class="min-w-100px text-center">Overtime (Hrs)</th>
                        <th class="min-w-100px text-center">Deduction (Hrs)</th>
                        <th class="min-w-110px text-center">Total Overtime</th>
                        <th class="min-w-110px text-center">Total Deduction</th>
                        <th class="min-w-120px text-center">Net Salary</th>
                        <th class="text-end min-w-110px no-print">Actions</th>
                    </tr>
                </thead>

                <tbody class="text-gray-600 fw-semibold">
                    @if (Model.ReportRecords != null && Model.ReportRecords.Any())
                    {
                        foreach (var item in Model.ReportRecords)
                        {
                            <tr>
                                <td class="text-gray-800 fw-bold">@item.EmployeeName</td>
                                <td>
                                    <span class="badge badge-light-info fs-7 fw-semibold">@item.DepartmentName</span>
                                </td>
                                <td>
                                    <span class="badge badge-light-secondary text-gray-800 fs-7 fw-bold">@item.BasicSalary.ToString("N2") EGP</span>
                                </td>
                                <td class="text-center">
                                    <span class="badge badge-light-success fs-7 fw-bold">@item.DaysPresent Days</span>
                                </td>
                                <td class="text-center">
                                    <span class="badge badge-light-danger fs-7 fw-bold">@item.DaysAbsent Days</span>
                                </td>
                                <td class="text-center">
                                    <span class="badge badge-light-primary fs-7 fw-bold">@item.OvertimeHours Hrs</span>
                                </td>
                                <td class="text-center">
                                    <span class="badge badge-light-warning fs-7 fw-bold">@item.DeductionHours Hrs</span>
                                </td>
                                <td class="text-center">
                                    <span class="badge badge-light-success fs-7 fw-bold">+ @item.TotalOvertime.ToString("N2") EGP</span>
                                </td>
                                <td class="text-center">
                                    <span class="badge badge-light-danger fs-7 fw-bold">- @item.TotalDeduction.ToString("N2") EGP</span>
                                </td>
                                <td class="text-center">
                                    <span class="badge badge-success fs-6 fw-bold">@item.NetSalary.ToString("N2") EGP</span>
                                </td>

                                <!-- Actions -->
                                <td class="text-end no-print">
                                    <div class="d-flex justify-content-end gap-2">

                                        <!-- Edit Employee -->
                                        <a asp-controller="Employee"
                                           asp-action="Edit"
                                           asp-route-id="@item.EmployeeId"
                                           class="btn btn-sm btn-icon btn-light-warning"
                                           title="Edit Employee">
                                            <i class="fa-solid fa-pen-to-square fs-5"></i>
                                        </a>

                                        <!-- Print / Export Dropdown Menu -->
                                        <div class="btn-group">
                                            <button type="button"
                                                    class="btn btn-sm btn-icon btn-light-primary dropdown-toggle hide-arrow"
                                                    data-bs-toggle="dropdown"
                                                    aria-expanded="false"
                                                    title="Export / Print Options">
                                                <i class="fa-solid fa-print fs-5"></i>
                                            </button>
                                            <ul class="dropdown-menu dropdown-menu-end shadow">
                                                <li>
                                                    <h6 class="dropdown-header text-muted text-uppercase fs-8">Payslip Options</h6>
                                                </li>
                                                <li>
                                                    <a class="dropdown-item py-2"
                                                       asp-controller="SalaryReport"
                                                       asp-action="ExportEmployeePayslipToPDF"
                                                       asp-route-employeeId="@item.EmployeeId"
                                                       asp-route-month="@Model.Month"
                                                       asp-route-year="@Model.Year">
                                                        <i class="fa-solid fa-file-pdf text-danger me-2"></i> Export to PDF
                                                    </a>
                                                </li>
                                                <li>
                                                    <a class="dropdown-item py-2"
                                                       asp-controller="SalaryReport"
                                                       asp-action="ExportEmployeePayslipToExcel"
                                                       asp-route-employeeId="@item.EmployeeId"
                                                       asp-route-month="@Model.Month"
                                                       asp-route-year="@Model.Year">
                                                        <i class="fa-solid fa-file-excel text-success me-2"></i> Export to Excel
                                                    </a>
                                                </li>
                                            </ul>
                                        </div>

                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="11" class="text-center text-muted py-8 fs-5">
                                No employee salary records found for the selected criteria.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>

        </div>
    </div>
    <!--end::Card body-->

</div>
<!--end::Card-->

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            if (typeof $ !== 'undefined' && $.fn.DataTable) {
                if (!$.fn.DataTable.isDataTable('#kt_table_salaries')) {
                    $("#kt_table_salaries").DataTable({
                        "searching": false,
                        "ordering": true,
                        "paging": true,
                        "pageLength": 10,
                        "lengthMenu": [5, 10, 25, 50],
                        "language": {
                            "lengthMenu": "Show _MENU_",
                            "info": "Showing _START_ to _END_ of _TOTAL_ entries",
                            "paginate": {
                                "previous": "<i class='previous'></i>",
                                "next": "<i class='next'></i>"
                            }
                        }
                    });
                }
            }
        });
    </script>
}