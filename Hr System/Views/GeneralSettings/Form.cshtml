@model Hr.Application.ViewModels.GeneralSettingsVms.FormVm

@{
    ViewData["Title"] = "General Settings";
}

<!--begin::Content wrapper-->
<div class="d-flex flex-column flex-column-fluid">
    <!--begin::Toolbar-->
    <div id="kt_app_toolbar" class="app-toolbar py-3 py-lg-6">
        <div id="kt_app_toolbar_container" class="app-container container-xxl d-flex flex-stack flex-wrap gap-2">
            <!--begin::Page title-->
            <div class="page-title d-flex flex-column justify-content-center flex-wrap me-3">
                <h1 class="page-heading d-flex text-dark fw-bold fs-3 flex-column justify-content-center my-0">General Settings</h1>
                <ul class="breadcrumb breadcrumb-separatorless fw-semibold fs-7 my-0 pt-1">
                    <li class="breadcrumb-item text-muted">
                        <a href="/" class="text-muted text-hover-primary">Home</a>
                    </li>
                    <li class="breadcrumb-item">
                        <span class="bullet bg-gray-400 w-5px h-2px"></span>
                    </li>
                    <li class="breadcrumb-item text-muted">Settings</li>
                </ul>
            </div>
            <!--end::Page title-->
        </div>
    </div>
    <!--end::Toolbar-->
    <!--begin::Content-->
    <div id="kt_app_content" class="app-content flex-column-fluid">
        <div id="kt_app_content_container" class="container-xxl">
            <form id="settings-form" asp-action="Save" method="post" class="form">
                <input type="hidden" asp-for="Id" />

                <div class="card card-flush py-4">
                    <!--begin::Card header-->
                    <div class="card-header">
                        <div class="card-title">
                            <h2>System General Settings</h2>
                        </div>
                    </div>
                    <!--end::Card header-->
                    <!--begin::Card body-->
                    <div class="card-body pt-0">
                        <div class="row g-5">

                            <!-- Overtime & Deduction Section -->
                            <div class="col-xl-6">
                                <div class="card card-dashed h-xl-100 flex-row flex-column justify-content-center p-6">
                                    <h3 class="fw-bold text-primary mb-5">Overtime & Deduction Settings</h3>

                                    <div class="mb-5 fv-row">
                                        <label class="required form-label">Overtime Value (per hour)</label>
                                        <div class="input-group input-group-solid">
                                            <input asp-for="OverTimeVal" type="number" step="0.01" class="form-control" placeholder="e.g. 2 hours value" />
                                            <span class="input-group-text">EGP</span>
                                        </div>
                                        <span asp-validation-for="OverTimeVal" class="text-danger mt-1"></span>
                                    </div>

                                    <div class="mb-5 fv-row">
                                        <label class="required form-label">Deduction Value (per late hour)</label>
                                        <div class="input-group input-group-solid">
                                            <input asp-for="DeducationVal" type="number" step="0.01" class="form-control" placeholder="e.g. deduction value" />
                                            <span class="input-group-text">EGP</span>
                                        </div>
                                        <span asp-validation-for="DeducationVal" class="text-danger mt-1"></span>
                                    </div>
                                </div>
                            </div>

                            <!-- Weekly Holidays Section -->
                            <div class="col-xl-6">
                                <div class="card card-dashed h-xl-100 flex-row flex-column justify-content-center p-6">
                                    <h3 class="fw-bold text-success mb-5">Weekly Holidays Settings</h3>

                                    <div class="mb-5 fv-row">
                                        <label class="required form-label">First Official Holiday</label>
                                        <select asp-for="FirstDay" class="form-select form-select-solid">
                                            <option value="">Select First Holiday</option>
                                            <option value="Friday">Friday</option>
                                            <option value="Saturday">Saturday</option>
                                            <option value="Sunday">Sunday</option>
                                            <option value="Monday">Monday</option>
                                            <option value="Tuesday">Tuesday</option>
                                            <option value="Wednesday">Wednesday</option>
                                            <option value="Thursday">Thursday</option>
                                        </select>
                                        <span asp-validation-for="FirstDay" class="text-danger mt-1"></span>
                                    </div>

                                    <div class="mb-5 fv-row">
                                        <label class="required form-label">Second Official Holiday</label>
                                        <select asp-for="SecondDay" class="form-select form-select-solid">
                                            <option value="">Select Second Holiday</option>
                                            <option value="Friday">Friday</option>
                                            <option value="Saturday">Saturday</option>
                                            <option value="Sunday">Sunday</option>
                                            <option value="Monday">Monday</option>
                                            <option value="Tuesday">Tuesday</option>
                                            <option value="Wednesday">Wednesday</option>
                                            <option value="Thursday">Thursday</option>
                                        </select>
                                        <span asp-validation-for="SecondDay" class="text-danger mt-1"></span>
                                    </div>
                                </div>
                            </div>

                        </div>
                    </div>
                    <!--end::Card body-->
                    <!--begin::Card footer-->
                    <div class="card-footer d-flex justify-content-end py-6 px-9 gap-3">
                        <button type="button" id="save-settings-btn" class="btn btn-primary">
                            <span class="indicator-label">Save Changes</span>
                        </button>
                    </div>
                    <!--end::Card footer-->
                </div>
            </form>
        </div>
    </div>
    <!--end::Content-->
</div>
<!--end::Content wrapper-->

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}

    <script>
        $(document).ready(function () {
            const $form = $('#settings-form');
            const $saveBtn = $('#save-settings-btn');
            const settingId = @Model.Id;

            if ($saveBtn.length && $form.length) {
                $saveBtn.on('click', function (e) {
                    e.preventDefault();

                    if ($form.valid && !$form.valid()) {
                        return;
                    }

                    if (settingId > 0) {
                        Swal.fire({
                            title: 'Are you sure?',
                            text: "You are about to update general settings.",
                            icon: 'question',
                            showCancelButton: true,
                            confirmButtonColor: '#009ef7',
                            cancelButtonColor: '#92929f',
                            confirmButtonText: 'Yes, update!',
                            cancelButtonText: 'Cancel'
                        }).then((result) => {
                            if (result.isConfirmed) {
                                $form.submit();
                            }
                        });
                    } else {
                        Swal.fire({
                            title: 'Saved Successfully!',
                            text: "General settings have been saved successfully.",
                            icon: 'success',
                            confirmButtonColor: '#50cd89',
                            confirmButtonText: 'OK'
                        }).then((result) => {
                            if (result.isConfirmed) {
                                $form.submit();
                            }
                        });
                    }
                });
            }
        });
    </script>
}