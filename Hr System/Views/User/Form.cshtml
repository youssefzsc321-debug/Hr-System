@model Hr.Application.ViewModels.User.UserFormVm

@{
    ViewData["Title"] = string.IsNullOrEmpty(Model.Id) ? "Add New User" : "Edit User";
}

<!--begin::Content container-->
<div id="kt_app_content_container" class="app-container container-xxl">
    <!--begin::Form-->
    <form asp-action="@(string.IsNullOrEmpty(Model.Id) ? "Create" : "Edit")" method="post" class="form">

        <!-- Hidden Id field for Edit mode -->
        <input type="hidden" asp-for="Id" />

        <div class="card card-flush py-4">
            <!--begin::Card header-->
            <div class="card-header">
                <div class="card-title">
                    <h2>@(string.IsNullOrEmpty(Model.Id) ? "User Details" : "Edit User Details")</h2>
                </div>
            </div>
            <!--end::Card header-->
            <!--begin::Card body-->
            <div class="card-body pt-0">

                <!-- Validation Summary -->
                <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                <!-- Full Name -->
                <div class="mb-10 fv-row">
                    <label class="required form-label">Full Name</label>
                    <input asp-for="FullName" class="form-control form-control-solid mb-2" placeholder="Enter full name" />
                    <span asp-validation-for="FullName" class="text-danger fs-7"></span>
                </div>

                <!-- Username -->
                <div class="mb-10 fv-row">
                    <label class="required form-label">User Name</label>
                    <input asp-for="UserName" class="form-control form-control-solid mb-2" placeholder="Enter username" />
                    <span asp-validation-for="UserName" class="text-danger fs-7"></span>
                </div>

                <!-- Email -->
                <div class="mb-10 fv-row">
                    <label class="required form-label">Email</label>
                    <input asp-for="Email" class="form-control form-control-solid mb-2" placeholder="name@example.com" />
                    <span asp-validation-for="Email" class="text-danger fs-7"></span>
                </div>

                <!-- Password & Confirm Password (تظهر فقط في حالة الإضافة Create) -->
                @if (string.IsNullOrEmpty(Model.Id))
                {
                    <div class="mb-10 fv-row">
                        <label class="required form-label">Password</label>
                        <input asp-for="Password" type="password" class="form-control form-control-solid mb-2" placeholder="Enter password" />
                        <span asp-validation-for="Password" class="text-danger fs-7"></span>
                    </div>

                    <div class="mb-10 fv-row">
                        <label class="required form-label">Confirm Password</label>
                        <input asp-for="ConfirmPassword" type="password" class="form-control form-control-solid mb-2" placeholder="Confirm password" />
                        <span asp-validation-for="ConfirmPassword" class="text-danger fs-7"></span>
                    </div>
                }

                <!-- Roles Selection -->
                <div class="mb-10 fv-row">
                    <label class="required form-label">Roles / Permissions Group</label>
                    <select asp-for="SelectedRoles" asp-items="Model.Roles" class="form-select form-select-solid" data-control="select2" data-placeholder="Select a role" multiple="multiple">
                    </select>
                    <span asp-validation-for="SelectedRoles" class="text-danger fs-7"></span>
                </div>

            </div>
            <!--end::Card body-->
            <!--begin::Card footer-->
            <div class="card-footer d-flex justify-content-end py-6 px-9">
                <a asp-action="Index" class="btn btn-light me-3">Cancel</a>
                <button type="submit" class="btn btn-primary">
                    <span class="indicator-label">Save Changes</span>
                </button>
            </div>
            <!--end::Card footer-->
        </div>
    </form>
    <!--end::Form-->
</div>
<!--end::Content container-->

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>
        $(document).ready(function () {
            $('[data-control="select2"]').select2();
        });
    </script>
}