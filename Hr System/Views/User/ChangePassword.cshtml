@model Hr.Application.ViewModels.User.UserPasswordVm

@{
    ViewData["Title"] = "Change User Password";
}

<div id="kt_app_content_container" class="app-container container-xxl">
    <form asp-action="ChangePassword" method="post" class="form">
        <input type="hidden" asp-for="Id" />

        <div class="card card-flush py-4">
            <div class="card-header">
                <div class="card-title">
                    <h2>Change Password for User</h2>
                </div>
            </div>
            <div class="card-body pt-0">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                <div class="mb-10 fv-row">
                    <label class="required form-label">New Password</label>
                    <input asp-for="Password" type="password" class="form-control form-control-solid mb-2" placeholder="Enter new password" />
                    <span asp-validation-for="Password" class="text-danger fs-7"></span>
                </div>

                <div class="mb-10 fv-row">
                    <label class="required form-label">Confirm New Password</label>
                    <input asp-for="ConfirmPassword" type="password" class="form-control form-control-solid mb-2" placeholder="Confirm password" />
                    <span asp-validation-for="ConfirmPassword" class="text-danger fs-7"></span>
                </div>
            </div>
            <div class="card-footer d-flex justify-content-end py-6 px-9">
                <a asp-action="Index" class="btn btn-light me-3">Cancel</a>
                <button type="submit" class="btn btn-primary">
                    <span class="indicator-label">Update Password</span>
                </button>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}